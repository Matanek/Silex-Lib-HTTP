use HTML
use HTTP
use HTTP.Client
use JSON
use STD.Network.TLS
use XML

func require_session(result:Result<Client.Session, HTTP.Error>) Client.Session {
    var output:Client.Session? = null
    match result {
        success(value) => { output = value }
        failure(error) => { panic(error.detail) }
    }
    if var session = output { return session }
    panic("public client session should be available")
}

test "compose public web package APIs" {
    var response = HTTP.Response.text(200, "{\"status\":\"ok\"}", "application/json")
    var response_text = ""
    match response.text() {
        success(text) => { response_text = text }
        failure(error) => { panic(error.detail) }
    }
    var payload = JSON.parse(response_text)
    assert(payload.require_string("status") == "ok")

    var page = HTML.parse("<!doctype html><h1>Silex</h1>")
    var headings = page.select("h1")
    assert(headings.count() == 1)
    if let heading = headings.first() {
        assert(heading.text_content() == "Silex")
    } else { panic("HTML selection should expose its first node") }

    var feed = XML.parse("<feed><entry>Silex</entry></feed>")
    assert(feed.elements("entry")[0].text_content() == "Silex")

    match HTTP.Url.parse("https://example.com/docs?q=1") {
        success(url) => {
            assert(url.port == 443)
            assert(url.target == "/docs?q=1")
        }
        failure(error) => { panic(error.detail) }
    }
    assert(HTTP.encode_query([
        HTTP.QueryParameter(name:"format", value:"html"),
        HTTP.QueryParameter(name:"language", value:"fr")
    ]) == "format=html&language=fr")
    assert(Client.default_options().maximum_redirects == 10)
    let bounded = Client.default_options()
        .with_total_timeout(5_000)
        .with_public_network_only()
    assert(bounded.address_policy == Client.AddressPolicy.public_only)
    var headers = HTTP.Headers()
    match headers.try_set("Accept", "application/json") {
        success => { assert(headers.contains("Accept")) }
        failure(error) => { panic(error.detail) }
    }
    var session = require_session(Client.Session.create(bounded))
    match session.authenticate_basic("silex", "secret") {
        success => {}
        failure(error) => { panic(error.detail) }
    }
    session.enable_cookies()
    assert(session.cookies_enabled())
    match session.close() {
        success => {}
        failure(error) => { panic(error.detail) }
    }
    assert(TLS.available())
}
