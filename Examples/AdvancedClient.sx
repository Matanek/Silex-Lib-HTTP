use HTTP
use HTTP.Client
use STD.Error
use STD.IO
use STD.Text.UTF8

class TextStream:IO.Reader, IO.Writer {
    private let input:uint8[]
    private var cursor:int
    private var output:uint8[]

    init(text:str) {
        self.input = UTF8.bytes(text)
        self.cursor = 0
        self.output = []
    }

    func read(buffer:&uint8[..]) Result<int, Error> {
        var count = 0
        while count < buffer.count() && self.cursor < self.input.count() {
            buffer[count] = self.input[self.cursor]
            count++
            self.cursor++
        }
        return Result<int, Error>.success(count)
    }

    func write(buffer:@uint8[..]) Result<int, Error> {
        for byte in buffer { self.output.append(byte) }
        return Result<int, Error>.success(buffer.count())
    }

    func output_count() int { return self.output.count() }
}

func run() Result<void, HTTP.Error> {
    let origin = "http://127.0.0.1:18081"

    var redirected = try Client.get(origin + "/redirect")
    assert(try redirected.text() == "redirected")

    var queried = try Client.get(origin + "/query?name=Silex%20HTTP")
    assert(try queried.text() == "Silex HTTP")

    var echoed = try Client.post(origin + "/echo", "hello")
    assert(try echoed.text() == "hello")

    var upload = TextStream("streamed upload")
    var upload_request = HTTP.Request.post("/upload")
    upload_request.headers().set("Content-Type", "application/octet-stream")
    var uploaded = try Client.send_stream<TextStream>(origin + "/upload", upload_request, upload, 15)
    assert(try uploaded.text() == "15")

    var download = TextStream("")
    var downloaded = try Client.download<TextStream>(origin + "/download", download)
    assert(downloaded.is_success())
    assert(download.output_count() == 4_096)
    let buffered = downloaded.body()
    assert(buffered.count() == 0)

    var redirected_download = TextStream("")
    var redirected_file = try Client.download<TextStream>(origin + "/redirect", redirected_download)
    assert(redirected_file.status() == 200)
    assert(redirected_download.output_count() == 10)

    print("redirect, query, upload and download verified")
    return Result<void, HTTP.Error>.success()
}

func main() {
    match run() {
        success => {}
        failure(error) => { panic(error.detail) }
    }
}
