use HTTP
use HTTP.Client
use HTML

func run() Result<void, HTTP.Error> {
    var response = try Client.get("https://example.com/")
    assert(response.is_success())
    var page = HTML.parse(try response.text())
    assert(page.select("h1").text_content() == "Example Domain")
    print("HTTPS $(response.status()): certificate and response verified")
    return Result<void, HTTP.Error>.success()
}

func main() {
    match run() {
        success => {}
        failure(error) => { panic(error.detail) }
    }
}
