use HTTP
use HTTP.Client
use HTML
use JSON

func run() Result<void, HTTP.Error> {
    var response = try Client.get("http://127.0.0.1:18080/api/health")
    if !response.is_success() { panic("server returned HTTP $(response.status())") }
    let text = try response.text()
    var body = JSON.parse(text)
    assert(body.require_string("status") == "ok")
    print("HTTP $(response.status()): $(body.require_string("status"))")

    var page_response = try Client.get("http://127.0.0.1:18080/")
    let page_text = try page_response.text()
    var page = HTML.parse(page_text)
    var headings = page.select("h1")
    assert(headings.text_content() == "Served by Silex")
    print("HTML: $(headings.text_content())")
    return Result<void, HTTP.Error>.success()
}

func main() {
    match run() {
        failure(error) => { panic(error.detail) }
        success => {}
    }
}
