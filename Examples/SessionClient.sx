use HTTP
use HTTP.Client

func run() Result<void, HTTP.Error> {
    var session = try Client.Session.create(
        Client.default_options().with_maximum_idle_connections_per_origin(4)
    )
    try session.set_default_header("Accept", "application/json")
    try session.authenticate_bearer("replace-with-a-token")
    session.enable_cookies()

    var first = try session.get("https://example.com/")
    print("$(first.response.status()) $(first.final_url.text())")

    var progressive = try session.open("https://example.com/")
    while !progressive.finished() {
        let bytes = try progressive.read(1_024)
        print("received $(bytes.count()) bytes")
    }

    print("idle connections: $(session.idle_connection_count())")
    return session.close()
}

func main() {
    match run() {
        success => {}
        failure(error) => { panic(error.detail) }
    }
}
