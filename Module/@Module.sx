use STD.Text.UTF8
use STD.Network
use STD.Time.Stopwatch

public enum Method {
    get
    head
    post
    put
    patch
    delete
    options
    trace
    connect
    custom(str)
}

public struct Header {
    let name:str
    let value:str
}

public struct QueryParameter {
    let name:str
    let value:str
}

public enum ErrorKind {
    invalid_url
    invalid_header
    invalid_request
    invalid_response
    invalid_configuration
    unsupported_scheme
    network
    secure_transport
    deadline_exceeded
    network_policy
    proxy
    malformed_message
    header_limit
    body_limit
    unsupported_transfer
    unsupported_upgrade
    redirect_limit
    insecure_redirect
    http_status
    body_stream
    invalid_text
    closed
}

public struct Error {
    let kind:ErrorKind
    let subject:str?
    let detail:str
}

package class DeadlineBudget {
    private let maximum_milliseconds:int?
    private var elapsed:Stopwatch

    init(maximum_milliseconds:int?) {
        self.maximum_milliseconds = maximum_milliseconds
        self.elapsed = Stopwatch()
        self.elapsed.start()
    }

    func check(subject:str) Result<void, Error> {
        if let maximum = self.maximum_milliseconds {
            if maximum < 0 {
                return Result<void, Error>.failure(failure(
                    ErrorKind.invalid_configuration, subject, "HTTP timeout must be non-negative"
                ))
            }
            if self.elapsed.get_elapsed_milliseconds() >= maximum as float {
                return Result<void, Error>.failure(failure(
                    ErrorKind.deadline_exceeded, subject, "HTTP total deadline exceeded"
                ))
            }
        }
        return Result<void, Error>.success()
    }

    func bounded_timeout(configured:int?, subject:str) Result<int?, Error> {
        match self.check(subject) {
            success => {}
            failure(error) => { return Result<int?, Error>.failure(error) }
        }
        if let maximum = self.maximum_milliseconds {
            var remaining = maximum
            if let value = configured {
                if value < 0 {
                    return Result<int?, Error>.failure(failure(
                        ErrorKind.invalid_configuration, subject, "HTTP timeout must be non-negative"
                    ))
                }
                if value < remaining { remaining = value }
            }
            return Result<int?, Error>.success(remaining)
        }
        if let value = configured {
            if value < 0 {
                return Result<int?, Error>.failure(failure(
                    ErrorKind.invalid_configuration, subject, "HTTP timeout must be non-negative"
                ))
            }
        }
        return Result<int?, Error>.success(configured)
    }
}

public struct Limits {
    let maximum_header_bytes:int
    let maximum_headers:int
    let maximum_body_bytes:int
    let maximum_informational_responses:int
}

public struct Url {
    let scheme:str
    let host:str
    let port:uint16
    let target:str

    static func parse(value:str) Result<Url, Error> { return parse_url(value) }

    func authority() str {
        var name = self.host
        if contains_byte(name, 58) { name = "[" + name + "]" }
        if (self.scheme == "http" && self.port == 80) || (self.scheme == "https" && self.port == 443) {
            return name
        }
        return name + ":" + decimal(self.port as int)
    }

    func text() str { return self.scheme + "://" + self.authority() + self.target }

    func path() str { return target_path(self.target) }
    func query() str? { return target_query(self.target) }
    func query_parameters() Result<QueryParameter[], Error> { return parse_query(self.target) }
    func query_parameter(name:str) Result<str?, Error> { return find_query_parameter(self.target, name) }
    func resolve(location:str) Result<Url, Error> { return resolve_url(self, location) }
}

public class Headers {
    private var entries:Header[]

    init() { self.entries = [] }

    func count() int { return self.entries.count() }
    func values() Header[] { return self.entries }

    func get(name:str) str? {
        let expected = ascii_lower(name)
        for entry in self.entries {
            if ascii_lower(entry.name) == expected { return entry.value }
        }
        return null
    }

    func get_all(name:str) str[] {
        let expected = ascii_lower(name)
        var result:str[] = []
        for entry in self.entries {
            if ascii_lower(entry.name) == expected { result.append(entry.value) }
        }
        return result
    }

    func contains(name:str) bool { return self.get(name) != null }

    func append(name:str, value:str) {
        match self.try_append(name, value) {
            success => {}
            failure(error) => { panic(error.detail) }
        }
    }

    func try_append(name:str, value:str) Result<void, Error> {
        match validate_header(name, value) {
            success => {}
            failure(error) => { return Result<void, Error>.failure(error) }
        }
        self.entries.append(Header(name:name, value:value))
        return Result<void, Error>.success()
    }

    func set(name:str, value:str) {
        match self.try_set(name, value) {
            success => {}
            failure(error) => { panic(error.detail) }
        }
    }

    func try_set(name:str, value:str) Result<void, Error> {
        match validate_header(name, value) {
            success => {}
            failure(error) => { return Result<void, Error>.failure(error) }
        }
        self.remove(name)
        self.entries.append(Header(name:name, value:value))
        return Result<void, Error>.success()
    }

    func remove(name:str) int {
        let expected = ascii_lower(name)
        var removed = 0
        var index = self.entries.count() - 1
        while index >= 0 && self.entries.count() > 0 {
            if ascii_lower(self.entries[index].name) == expected {
                self.entries.take(index)
                removed++
            }
            index--
        }
        return removed
    }
}

public class Request {
    private let request_method:Method
    private let request_target:str
    private var request_headers:Headers
    private var request_body:uint8[]
    private var request_peer:Network.Endpoint?

    init(method:Method, target:str) {
        if !valid_method_text(method_text(method)) { panic("HTTP request method contains an invalid byte") }
        if !valid_request_target(target) { panic("HTTP request target contains an invalid byte") }
        self.request_method = method
        self.request_target = target
        self.request_headers = Headers()
        self.request_body = []
        self.request_peer = null
    }

    static func try_new(method:Method, target:str) Result<Request, Error> {
        if !valid_method_text(method_text(method)) {
            return Result<Request, Error>.failure(failure(
                ErrorKind.invalid_request,
                method_text(method),
                "HTTP request method contains an invalid byte"
            ))
        }
        if !valid_request_target(target) {
            return Result<Request, Error>.failure(failure(
                ErrorKind.invalid_request,
                target,
                "HTTP request target contains an invalid byte"
            ))
        }
        return Result<Request, Error>.success(Request(method, target))
    }

    static func get(target:str) Request { return Request(Method.get, target) }
    static func head(target:str) Request { return Request(Method.head, target) }
    static func post(target:str) Request { return Request(Method.post, target) }
    static func put(target:str) Request { return Request(Method.put, target) }
    static func patch(target:str) Request { return Request(Method.patch, target) }
    static func delete(target:str) Request { return Request(Method.delete, target) }

    func method() Method { return self.request_method }
    func target() str { return self.request_target }
    func path() str { return target_path(self.request_target) }
    func query() str? { return target_query(self.request_target) }
    func query_parameters() Result<QueryParameter[], Error> { return parse_query(self.request_target) }
    func query_parameter(name:str) Result<str?, Error> {
        return find_query_parameter(self.request_target, name)
    }
    func peer() Network.Endpoint? { return self.request_peer }
    func headers() Headers { return self.request_headers }
    func body() uint8[] { return self.request_body }

    func set_body(bytes:uint8[]) { self.request_body = bytes }

    func set_text(text:str, content_type:str = "text/plain; charset=utf-8") {
        self.request_body = UTF8.bytes(text)
        self.request_headers.set("Content-Type", content_type)
    }

    func text() Result<str, Error> { return decode_text(self.request_body, "HTTP request body") }

    package func replace_headers(headers:Headers) { self.request_headers = headers }
    package func set_peer(endpoint:Network.Endpoint) { self.request_peer = endpoint }
}

public class Response {
    private let response_status:int
    private let response_reason:str
    private var response_headers:Headers
    private var response_body:uint8[]

    init(status:int, reason:str = "") {
        if status < 100 || status > 999 { panic("HTTP response status must have three digits") }
        if !valid_reason(reason) { panic("HTTP response reason contains a forbidden control byte") }
        self.response_status = status
        self.response_reason = reason
        self.response_headers = Headers()
        self.response_body = []
    }

    static func try_new(status:int, reason:str = "") Result<Response, Error> {
        if status < 100 || status > 999 {
            return Result<Response, Error>.failure(failure(
                ErrorKind.invalid_response,
                decimal(status),
                "HTTP response status must have three digits"
            ))
        }
        if !valid_reason(reason) {
            return Result<Response, Error>.failure(failure(
                ErrorKind.invalid_response,
                reason,
                "HTTP response reason contains a forbidden control byte"
            ))
        }
        return Result<Response, Error>.success(Response(status, reason))
    }

    static func text(
        status:int,
        text:str,
        content_type:str = "text/plain; charset=utf-8"
    ) Response {
        var response = Response(status, reason_phrase(status))
        response.response_body = UTF8.bytes(text)
        response.response_headers.set("Content-Type", content_type)
        return response
    }

    static func bytes(status:int, body:uint8[], content_type:str) Response {
        var response = Response(status, reason_phrase(status))
        response.response_body = body
        response.response_headers.set("Content-Type", content_type)
        return response
    }

    func status() int { return self.response_status }
    func reason() str { return self.response_reason }
    func headers() Headers { return self.response_headers }
    func body() uint8[] { return self.response_body }
    func is_success() bool { return self.response_status >= 200 && self.response_status < 300 }
    func is_redirect() bool {
        return self.response_status == 301 || self.response_status == 302 || self.response_status == 303 ||
            self.response_status == 307 || self.response_status == 308
    }
    func location() str? { return self.response_headers.get("Location") }
    func text() Result<str, Error> { return decode_text(self.response_body, "HTTP response body") }

    func require_success() Result<void, Error> {
        if self.is_success() { return Result<void, Error>.success() }
        return Result<void, Error>.failure(failure(
            ErrorKind.http_status,
            decimal(self.response_status),
            "HTTP response status is not successful"
        ))
    }

    package func replace_headers(headers:Headers) { self.response_headers = headers }
    package func replace_body(body:uint8[]) { self.response_body = body }
}

public func default_limits() Limits {
    return Limits(
        maximum_header_bytes:64 * 1024,
        maximum_headers:128,
        maximum_body_bytes:16 * 1024 * 1024,
        maximum_informational_responses:8
    )
}

public func encode_query_component(value:str) str {
    var result = ""
    for byte in UTF8.bytes(value) {
        if query_unreserved(byte) { result += text_from_byte(byte) }
        else {
            result += "%"
            result += text_from_byte(hex_upper((byte / 16) as int))
            result += text_from_byte(hex_upper((byte % 16) as int))
        }
    }
    return result
}

public func decode_query_component(value:str) Result<str, Error> {
    let bytes = UTF8.bytes(value)
    var decoded:uint8[] = []
    var index = 0
    while index < bytes.count() {
        if bytes[index] == 37 {
            if index + 2 >= bytes.count() {
                return Result<str, Error>.failure(failure(
                    ErrorKind.invalid_url, value, "query percent escape is incomplete"
                ))
            }
            let high = hex_value(bytes[index + 1])
            let low = hex_value(bytes[index + 2])
            if high < 0 || low < 0 {
                return Result<str, Error>.failure(failure(
                    ErrorKind.invalid_url, value, "query percent escape is not hexadecimal"
                ))
            }
            decoded.append((high * 16 + low) as uint8)
            index += 3
            continue
        }
        if bytes[index] == 43 { decoded.append(32 as uint8) }
        else { decoded.append(bytes[index]) }
        index++
    }
    if decoded.is_empty() { return Result<str, Error>.success("") }
    match UTF8.decode(@decoded[0:decoded.count()]) {
        success(text) => { return Result<str, Error>.success(text) }
        failure(error) => {
            return Result<str, Error>.failure(failure(
                ErrorKind.invalid_url,
                value,
                "decoded query is not valid UTF-8 at byte $(error.byte_offset)"
            ))
        }
    }
}

public func encode_query(parameters:QueryParameter[]) str {
    var result = ""
    for parameter in parameters {
        if result != "" { result += "&" }
        result += encode_query_component(parameter.name)
        result += "="
        result += encode_query_component(parameter.value)
    }
    return result
}

public func method_text(method:Method) str {
    return match method {
        get => "GET"
        head => "HEAD"
        post => "POST"
        put => "PUT"
        patch => "PATCH"
        delete => "DELETE"
        options => "OPTIONS"
        trace => "TRACE"
        connect => "CONNECT"
        custom(value) => value
    }
}

package func parse_method(value:str) Method {
    if value == "GET" { return Method.get }
    if value == "HEAD" { return Method.head }
    if value == "POST" { return Method.post }
    if value == "PUT" { return Method.put }
    if value == "PATCH" { return Method.patch }
    if value == "DELETE" { return Method.delete }
    if value == "OPTIONS" { return Method.options }
    if value == "TRACE" { return Method.trace }
    if value == "CONNECT" { return Method.connect }
    return Method.custom(value)
}

package func failure(kind:ErrorKind, subject:str?, detail:str) Error {
    return Error(kind:kind, subject:subject, detail:detail)
}

package func ascii_lower(value:str) str {
    var bytes = UTF8.bytes(value)
    var index = 0
    while index < bytes.count() {
        if bytes[index] >= 65 && bytes[index] <= 90 { bytes[index] += 32 }
        index++
    }
    return text_from_bytes(bytes)
}

package func trim(value:str) str {
    let bytes = UTF8.bytes(value)
    var start = 0
    var end = bytes.count()
    while start < end && (bytes[start] == 32 || bytes[start] == 9) { start++ }
    while end > start && (bytes[end - 1] == 32 || bytes[end - 1] == 9) { end-- }
    if start == end { return "" }
    var result:uint8[] = []
    var index = start
    while index < end { result.append(bytes[index]); index++ }
    return text_from_bytes(result)
}

package func decimal(value:int) str {
    if value == 0 { return "0" }
    var bytes:uint8[] = []
    var remaining = value
    while remaining > 0 {
        bytes.prepend((48 + remaining % 10) as uint8)
        remaining /= 10
    }
    return text_from_bytes(bytes)
}

package func text_from_bytes(bytes:uint8[]) str {
    if bytes.count() == 0 { return "" }
    match UTF8.decode(@bytes[0:bytes.count()]) {
        success(text) => { return text }
        failure(error) => { panic("internal HTTP text is not UTF-8") }
    }
}

func decode_text(bytes:uint8[], subject:str) Result<str, Error> {
    if bytes.count() == 0 { return Result<str, Error>.success("") }
    match UTF8.decode(@bytes[0:bytes.count()]) {
        success(text) => { return Result<str, Error>.success(text) }
        failure(error) => {
            return Result<str, Error>.failure(failure(
                ErrorKind.invalid_text,
                subject,
                "body is not valid UTF-8 at byte $(error.byte_offset)"
            ))
        }
    }
}

func parse_url(value:str) Result<Url, Error> {
    let bytes = UTF8.bytes(value)
    var separator = -1
    var index = 0
    while index + 2 < bytes.count() {
        if bytes[index] == 58 && bytes[index + 1] == 47 && bytes[index + 2] == 47 {
            separator = index
            break
        }
        index++
    }
    if separator <= 0 {
        return Result<Url, Error>.failure(failure(ErrorKind.invalid_url, value, "URL requires an http:// or https:// scheme"))
    }
    let scheme = ascii_lower(byte_slice(bytes, 0, separator))
    if scheme != "http" && scheme != "https" {
        return Result<Url, Error>.failure(failure(ErrorKind.unsupported_scheme, value, "HTTP supports only http and https URLs"))
    }
    let authority_start = separator + 3
    var authority_end = authority_start
    while authority_end < bytes.count() && bytes[authority_end] != 47 && bytes[authority_end] != 63 && bytes[authority_end] != 35 { authority_end++ }
    if authority_end == authority_start {
        return Result<Url, Error>.failure(failure(ErrorKind.invalid_url, value, "URL host is empty"))
    }
    let authority = byte_slice(bytes, authority_start, authority_end)
    for byte in UTF8.bytes(authority) {
        if byte <= 32 || byte == 127 || byte == 92 {
            return Result<Url, Error>.failure(failure(
                ErrorKind.invalid_url, value, "URL authority contains an invalid byte"
            ))
        }
    }
    if contains_byte(authority, 64) {
        return Result<Url, Error>.failure(failure(ErrorKind.invalid_url, value, "userinfo is not supported in HTTP URLs"))
    }
    var host = authority
    var port = 80 as uint16
    if scheme == "https" { port = 443 as uint16 }
    let authority_bytes = UTF8.bytes(authority)
    if authority_bytes[0] == 91 {
        var closing = 1
        while closing < authority_bytes.count() && authority_bytes[closing] != 93 { closing++ }
        if closing >= authority_bytes.count() {
            return Result<Url, Error>.failure(failure(ErrorKind.invalid_url, value, "IPv6 host is missing a closing bracket"))
        }
        host = byte_slice(authority_bytes, 1, closing)
        if closing + 1 < authority_bytes.count() {
            if authority_bytes[closing + 1] != 58 {
                return Result<Url, Error>.failure(failure(ErrorKind.invalid_url, value, "invalid text after IPv6 host"))
            }
            match parse_port(byte_slice(authority_bytes, closing + 2, authority_bytes.count()), value) {
                success(parsed) => { port = parsed }
                failure(error) => { return Result<Url, Error>.failure(error) }
            }
        }
    } else {
        var colon = -1
        index = 0
        while index < authority_bytes.count() {
            if authority_bytes[index] == 58 { colon = index }
            index++
        }
        if colon >= 0 {
            host = byte_slice(authority_bytes, 0, colon)
            match parse_port(byte_slice(authority_bytes, colon + 1, authority_bytes.count()), value) {
                success(parsed) => { port = parsed }
                failure(error) => { return Result<Url, Error>.failure(error) }
            }
        }
    }
    if host == "" {
        return Result<Url, Error>.failure(failure(ErrorKind.invalid_url, value, "URL host is empty"))
    }
    var target = "/"
    if authority_end < bytes.count() {
        let tail = byte_slice(bytes, authority_end, bytes.count())
        if bytes[authority_end] == 63 { target = "/" + tail }
        elif bytes[authority_end] == 35 { target = "/" }
        else { target = tail }
        let target_bytes = UTF8.bytes(target)
        var fragment = -1
        index = 0
        while index < target_bytes.count() {
            if target_bytes[index] == 35 { fragment = index; break }
            index++
        }
        if fragment >= 0 { target = byte_slice(target_bytes, 0, fragment) }
    }
    return Result<Url, Error>.success(Url(scheme:scheme, host:host, port:port, target:target))
}

func resolve_url(base:Url, location:str) Result<Url, Error> {
    let trimmed = trim(location)
    if trimmed == "" {
        return Result<Url, Error>.failure(failure(
            ErrorKind.invalid_url, location, "redirect location is empty"
        ))
    }
    if starts_with_text(ascii_lower(trimmed), "http://") || starts_with_text(ascii_lower(trimmed), "https://") {
        return Url.parse(trimmed)
    }
    let prefix = base.scheme + "://" + base.authority()
    if starts_with_text(trimmed, "//") { return Url.parse(base.scheme + ":" + trimmed) }
    if starts_with_text(trimmed, "/") { return Url.parse(prefix + trimmed) }
    if starts_with_text(trimmed, "?") { return Url.parse(prefix + base.path() + trimmed) }
    if starts_with_text(trimmed, "#") { return Url.parse(prefix + base.target + trimmed) }
    let path = base.path()
    let bytes = UTF8.bytes(path)
    var slash = bytes.count() - 1
    while slash >= 0 && bytes[slash] != 47 { slash-- }
    var directory = "/"
    if slash >= 0 { directory = byte_slice(bytes, 0, slash + 1) }
    return Url.parse(prefix + normalize_path(directory + trimmed))
}

func target_path(target:str) str {
    let bytes = UTF8.bytes(target)
    var end = bytes.count()
    var index = 0
    while index < bytes.count() {
        if bytes[index] == 63 || bytes[index] == 35 { end = index; break }
        index++
    }
    if end == 0 { return "/" }
    return byte_slice(bytes, 0, end)
}

func target_query(target:str) str? {
    let bytes = UTF8.bytes(target)
    var start = -1
    var end = bytes.count()
    var index = 0
    while index < bytes.count() {
        if bytes[index] == 63 && start < 0 { start = index + 1 }
        elif bytes[index] == 35 { end = index; break }
        index++
    }
    if start < 0 { return null }
    return byte_slice(bytes, start, end)
}

func parse_query(target:str) Result<QueryParameter[], Error> {
    var result:QueryParameter[] = []
    if let query = target_query(target) {
        if query == "" { return Result<QueryParameter[], Error>.success(result) }
        let bytes = UTF8.bytes(query)
        var start = 0
        var index = 0
        while index <= bytes.count() {
            if index == bytes.count() || bytes[index] == 38 {
                let item = byte_slice(bytes, start, index)
                let item_bytes = UTF8.bytes(item)
                var equals = -1
                var cursor = 0
                while cursor < item_bytes.count() {
                    if item_bytes[cursor] == 61 { equals = cursor; break }
                    cursor++
                }
                var raw_name = item
                var raw_value = ""
                if equals >= 0 {
                    raw_name = byte_slice(item_bytes, 0, equals)
                    raw_value = byte_slice(item_bytes, equals + 1, item_bytes.count())
                }
                let name = try decode_query_component(raw_name)
                let value = try decode_query_component(raw_value)
                result.append(QueryParameter(name:name, value:value))
                start = index + 1
            }
            index++
        }
    }
    return Result<QueryParameter[], Error>.success(result)
}

func find_query_parameter(target:str, expected:str) Result<str?, Error> {
    let parameters = try parse_query(target)
    for parameter in parameters {
        if parameter.name == expected { return Result<str?, Error>.success(parameter.value) }
    }
    return Result<str?, Error>.success(null)
}

func normalize_path(value:str) str {
    let bytes = UTF8.bytes(value)
    var end = bytes.count()
    var suffix = ""
    var index = 0
    while index < bytes.count() {
        if bytes[index] == 63 || bytes[index] == 35 {
            end = index
            suffix = byte_slice(bytes, index, bytes.count())
            break
        }
        index++
    }
    var segments:str[] = []
    var start = 0
    index = 0
    while index <= end {
        if index == end || bytes[index] == 47 {
            let segment = byte_slice(bytes, start, index)
            if segment == ".." {
                if !segments.is_empty() { segments.take_last() }
            } elif segment != "" && segment != "." { segments.append(segment) }
            start = index + 1
        }
        index++
    }
    var result = "/"
    index = 0
    while index < segments.count() {
        if index > 0 { result += "/" }
        result += segments[index]
        index++
    }
    if end > 0 && bytes[end - 1] == 47 && result != "/" { result += "/" }
    return result + suffix
}

func parse_port(value:str, subject:str) Result<uint16, Error> {
    let bytes = UTF8.bytes(value)
    if bytes.count() == 0 {
        return Result<uint16, Error>.failure(failure(ErrorKind.invalid_url, subject, "URL port is empty"))
    }
    var number = 0
    for byte in bytes {
        if byte < 48 || byte > 57 {
            return Result<uint16, Error>.failure(failure(ErrorKind.invalid_url, subject, "URL port is not numeric"))
        }
        number = number * 10 + (byte - 48) as int
        if number > 65_535 {
            return Result<uint16, Error>.failure(failure(ErrorKind.invalid_url, subject, "URL port is outside uint16"))
        }
    }
    if number == 0 {
        return Result<uint16, Error>.failure(failure(ErrorKind.invalid_url, subject, "URL port must be positive"))
    }
    return Result<uint16, Error>.success(number as uint16)
}

func validate_header(name:str, value:str) Result<void, Error> {
    let name_bytes = UTF8.bytes(name)
    if name_bytes.count() == 0 {
        return Result<void, Error>.failure(failure(
            ErrorKind.invalid_header, name, "HTTP header name cannot be empty"
        ))
    }
    for byte in name_bytes {
        if !header_name_byte(byte) {
            return Result<void, Error>.failure(failure(
                ErrorKind.invalid_header, name, "HTTP header name contains an invalid byte"
            ))
        }
    }
    for byte in UTF8.bytes(value) {
        if (byte < 32 && byte != 9) || byte == 127 {
            return Result<void, Error>.failure(failure(
                ErrorKind.invalid_header, name, "HTTP header value contains a forbidden control character"
            ))
        }
    }
    return Result<void, Error>.success()
}

package func valid_method_text(value:str) bool {
    let bytes = UTF8.bytes(value)
    if bytes.is_empty() { return false }
    for byte in bytes { if !header_name_byte(byte) { return false } }
    return true
}

package func valid_request_target(value:str) bool {
    let bytes = UTF8.bytes(value)
    if bytes.is_empty() { return false }
    for byte in bytes {
        if byte <= 32 || byte == 127 { return false }
    }
    return true
}

func valid_reason(value:str) bool {
    for byte in UTF8.bytes(value) {
        if (byte < 32 && byte != 9) || byte == 127 { return false }
    }
    return true
}

package func header_name_byte(byte:uint8) bool {
    if (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) { return true }
    return byte == 33 || byte == 35 || byte == 36 || byte == 37 || byte == 38 || byte == 39 ||
        byte == 42 || byte == 43 || byte == 45 || byte == 46 || byte == 94 || byte == 95 ||
        byte == 96 || byte == 124 || byte == 126
}

package func byte_slice(bytes:uint8[], start:int, end:int) str {
    if start >= end { return "" }
    var result:uint8[] = []
    var index = start
    while index < end { result.append(bytes[index]); index++ }
    return text_from_bytes(result)
}

func contains_byte(value:str, expected:uint8) bool {
    for byte in UTF8.bytes(value) { if byte == expected { return true } }
    return false
}

func starts_with_text(value:str, prefix:str) bool {
    let bytes = UTF8.bytes(value)
    let expected = UTF8.bytes(prefix)
    if bytes.count() < expected.count() { return false }
    var index = 0
    while index < expected.count() {
        if bytes[index] != expected[index] { return false }
        index++
    }
    return true
}

func query_unreserved(byte:uint8) bool {
    return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) ||
        (byte >= 48 && byte <= 57) || byte == 45 || byte == 46 || byte == 95 || byte == 126
}

func hex_upper(value:int) uint8 {
    if value < 10 { return (48 + value) as uint8 }
    return (55 + value) as uint8
}

func hex_value(byte:uint8) int {
    if byte >= 48 && byte <= 57 { return (byte - 48) as int }
    if byte >= 65 && byte <= 70 { return (byte - 55) as int }
    if byte >= 97 && byte <= 102 { return (byte - 87) as int }
    return -1
}

func text_from_byte(byte:uint8) str {
    var bytes:uint8[] = [byte]
    return text_from_bytes(bytes)
}

func reason_phrase(status:int) str {
    if status == 200 { return "OK" }
    if status == 201 { return "Created" }
    if status == 204 { return "No Content" }
    if status == 301 { return "Moved Permanently" }
    if status == 302 { return "Found" }
    if status == 304 { return "Not Modified" }
    if status == 400 { return "Bad Request" }
    if status == 404 { return "Not Found" }
    if status == 405 { return "Method Not Allowed" }
    if status == 408 { return "Request Timeout" }
    if status == 413 { return "Content Too Large" }
    if status == 431 { return "Request Header Fields Too Large" }
    if status == 500 { return "Internal Server Error" }
    if status == 501 { return "Not Implemented" }
    return ""
}
